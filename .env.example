# ==============================================================================
# EMMIL SAAS OUTREACH PLATFORM - ENVIRONMENT TEMPLATE
# ==============================================================================

# Supabase Credentials (frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Backend Worker Supabase Service Role Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Master Encryption Key (for email credentials)
ENCRYPTION_KEY=your_random_32_character_master_key

# Redis Queue Connection for BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Worker Configuration
IMAP_SYNC_INTERVAL_MS=120000
SCHEDULER_INTERVAL_MS=60000
